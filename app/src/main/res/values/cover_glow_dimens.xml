<?xml version="1.0" encoding="utf-8"?>
<!-- Cover Glow's game screen on narrow screens (phones held upright, a foldable's cover screen).
     values-w480dp holds the sizes for wide, short screens and values-w480dp-h520dp for tablets. -->
<resources>
    <dimen name="cg_content_padding">20dp</dimen>
    <dimen name="cg_content_padding_top">20dp</dimen>
    <!-- Under 360 dp wide a 15-character PC name, like Windows gives, leaves no room for a bigger
         wordmark. Phones get one (values-w360dp). -->
    <dimen name="cg_wordmark_size">26sp</dimen>
    <!-- The wordmark shrinks to stay 8 dp clear of a long PC name, down to the size it had before
         it got bigger. It goes smaller, to cg_wordmark_smallest_size at the least, only if it
         would still run into the name (WordmarkRow). -->
    <dimen name="cg_wordmark_min_size">26sp</dimen>
    <dimen name="cg_wordmark_smallest_size">26sp</dimen>
    <dimen name="cg_hero_cover_width">112dp</dimen>
    <dimen name="cg_hero_cover_height">150dp</dimen>
    <dimen name="cg_hero_gap">16dp</dimen>
    <dimen name="cg_hero_title_size">28sp</dimen>
    <dimen name="cg_hero_title_margin_top">6dp</dimen>
    <dimen name="cg_hero_top_margin">16dp</dimen>
    <dimen name="cg_hero_button_height">56dp</dimen>
    <integer name="cg_hero_title_lines">2</integer>
    <dimen name="cg_cover_row_margin_top">22dp</dimen>

    <!-- The wordmark sits at the end, clear of the PC name, when there's no room to centre it -->
    <style name="CgWordmarkPlace">
        <item name="android:layout_gravity">end|center_vertical</item>
    </style>

    <!-- Play and "This game's settings" stack instead of squeezing the Play label away -->
    <style name="CgHeroButtons">
        <item name="android:orientation">vertical</item>
        <item name="android:layout_below">@id/heroChips</item>
        <item name="android:layout_marginTop">18dp</item>
    </style>
    <style name="CgHeroSettingsButton">
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>

    <!-- The chips sit under the title, over the buttons -->
    <style name="CgHeroChipsPlace">
        <item name="android:layout_below">@id/heroTitle</item>
        <item name="android:layout_marginTop">14dp</item>
    </style>
</resources>
