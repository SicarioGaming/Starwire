<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:seekbar="http://schemas.moonlight-stream.com/apk/res/seekbar">

    <PreferenceCategory android:title="@string/category_basic_settings"
        android:key="category_basic_settings">
        <com.limelight.preferences.ResolutionListPreference
            android:key="list_resolution"
            android:title="@string/title_resolution_list"
            android:summary="@string/summary_resolution_list"
            android:entries="@array/resolution_names"
            android:entryValues="@array/resolution_values"
            android:defaultValue="1280x720" />
        <com.limelight.preferences.FpsListPreference
            android:key="list_fps"
            android:title="@string/title_fps_list"
            android:summary="@string/summary_fps_list"
            android:entries="@array/fps_names"
            android:entryValues="@array/fps_values"
            android:defaultValue="60" />
        <com.limelight.preferences.SeekBarPreference
            android:key="seekbar_bitrate_kbps"
            android:dialogMessage="@string/summary_seekbar_bitrate"
            seekbar:min="500"
            android:max="150000"
            seekbar:step="500"
            seekbar:keyStep="1000"
            seekbar:divisor="1000"
            seekbar:custom="true"
            android:summary="@string/summary_seekbar_bitrate"
            android:text="@string/suffix_seekbar_bitrate_mbps"
            android:title="@string/title_seekbar_bitrate" />
        <ListPreference
            android:key="frame_pacing"
            android:title="@string/title_frame_pacing"
            android:entries="@array/video_frame_pacing_names"
            android:entryValues="@array/video_frame_pacing_values"
            android:summary="@string/summary_frame_pacing"
            android:defaultValue="balanced" />
        <ListPreference
            android:key="jitter_buffer"
            android:title="@string/title_jitter_buffer"
            android:entries="@array/jitter_buffer_names"
            android:entryValues="@array/jitter_buffer_values"
            android:summary="@string/summary_jitter_buffer"
            android:defaultValue="balanced" />
        <ListPreference
            android:key="vsync_mode"
            android:title="@string/title_vsync_mode"
            android:entries="@array/vsync_mode_names"
            android:entryValues="@array/vsync_mode_values"
            android:summary="@string/summary_vsync_mode"
            android:defaultValue="off" />
        <CheckBoxPreference
            android:key="checkbox_sync_lfr"
            android:title="@string/title_checkbox_sync_lfr"
            android:summary="@string/summary_checkbox_sync_lfr"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="checkbox_async_decode"
            android:title="@string/title_checkbox_async_decode"
            android:summary="@string/summary_checkbox_async_decode"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="checkbox_async_lfr"
            android:dependency="checkbox_async_decode"
            android:title="@string/title_checkbox_async_lfr"
            android:summary="@string/summary_checkbox_async_lfr"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:defaultValue="false"
            android:key="checkbox_ultra_low_latency"
            android:summary="@string/summary_checkbox_ultra_low_latency"
            android:title="@string/title_checkbox_ultra_low_latency" />
        <CheckBoxPreference
            android:key="checkbox_stretch_video"
            android:title="@string/title_checkbox_stretch_video"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="checkbox_auto_resume_stream"
            android:title="@string/title_checkbox_auto_resume_stream"
            android:summary="@string/summary_checkbox_auto_resume_stream"
            android:defaultValue="false" />
    </PreferenceCategory>
    <PreferenceCategory android:key="category_audio_settings" android:title="@string/category_audio_settings">
        <ListPreference
            android:key="list_audio_config"
            android:title="@string/title_audio_config_list"
            android:summary="@string/summary_audio_config_list"
            android:entries="@array/audio_config_names"
            android:entryValues="@array/audio_config_values"
            android:defaultValue="2" />
        <CheckBoxPreference
            android:key="checkbox_enable_audiofx"
            android:title="@string/title_checkbox_enable_audiofx"
            android:summary="@string/summary_checkbox_enable_audiofx"
            android:defaultValue="false" />
        <CheckBoxPreference
            android:key="checkbox_enable_microphone"
            android:title="@string/title_checkbox_enable_microphone"
            android:summary="@string/summary_checkbox_enable_microphone"
            android:defaultValue="false" />
        <!-- Where the microphone goes: to Starwire's receiver on the PC (encrypted, any host), to
             another VBAN receiver (not encrypted), or over the stream (logabell's Apollo build).
             Only the rows for the chosen one show (StreamSettings.showMicrophoneTarget). -->
        <ListPreference
            android:key="list_microphone_target"
            android:dependency="checkbox_enable_microphone"
            android:title="@string/title_microphone_target"
            android:summary="%s"
            android:entries="@array/microphone_target_names"
            android:entryValues="@array/microphone_target_values"
            android:defaultValue="starwire" />
        <ListPreference
            android:key="list_microphone_device"
            android:dependency="checkbox_enable_microphone"
            android:title="@string/title_microphone_device_list"
            android:summary="@string/summary_microphone_device_list"
            android:defaultValue="0" />
        <!-- WebLauncherPreference falls back to an in-app page on devices with no browser (TVs) -->
        <com.limelight.preferences.WebLauncherPreference
            android:key="microphone_host_info"
            android:title="@string/title_microphone_host_info"
            android:summary="@string/summary_microphone_host_info"
            url="https://github.com/logabell/apollo-microphone/releases" />
        <com.limelight.preferences.WebLauncherPreference
            android:key="vban_setup_info"
            android:dependency="checkbox_enable_microphone"
            android:title="@string/title_vban_setup"
            url="https://github.com/SicarioGaming/Starwire/tree/main/windows#readme" />
        <!-- Opens MicPairingDialog -->
        <Preference
            android:key="mic_pairing"
            android:dependency="checkbox_enable_microphone"
            android:title="@string/title_mic_pairing"
            android:summary="@string/summary_mic_pairing_none" />
        <EditTextPreference
            android:key="text_vban_stream_name"
            android:dependency="checkbox_enable_microphone"
            android:title="@string/title_vban_stream_name"
            android:defaultValue="Stream1"
            android:singleLine="true"
            android:maxLength="16" />
        <EditTextPreference
            android:key="text_vban_port"
            android:dependency="checkbox_enable_microphone"
            android:title="@string/title_vban_port"
            android:defaultValue="6980"
            android:inputType="number"
            android:maxLength="5" />
        <ListPreference
            android:key="list_audio_haptics"
            android:title="@string/title_audio_haptics"
            android:summary="@string/summary_audio_haptics"
            android:entries="@array/audio_haptics_names"
            android:entryValues="@array/audio_haptics_values"
            android:defaultValue="off" />
        <com.limelight.preferences.SeekBarPreference
            android:key="seekbar_audio_haptics_intensity"
            android:defaultValue="100"
            seekbar:min="25"
            android:max="200"
            seekbar:step="5"
            android:summary="@string/summary_audio_haptics_intensity"
            android:text="@string/suffix_seekbar_deadzone"
            android:title="@string/title_audio_haptics_intensity"/>
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/category_gamepad_settings"
        android:key="category_gamepad_settings">
        <com.limelight.preferences.SeekBarPreference
